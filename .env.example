# Ticket Booking System - Environment Variables
# Copy this file to .env and fill in the values before running in development, or set these in your production host (Vercel).

# Database Configuration (Neon, Supabase, etc.)
# DATABASE_URL is used for connection pooling
DATABASE_URL="postgresql://user:password@host/dbname?pgbouncer=true&connection_limit=1"
# DIRECT_URL is used for Prisma migrations
DIRECT_URL="postgresql://user:password@host/dbname"

# NextAuth Configuration
# Run `openssl rand -base64 32` to generate a secret
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Email Configuration (Resend)
# Required for sending ticket transfer emails and receipts
RESEND_API_KEY="re_your_resend_api_key_here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security & Cron Jobs
# A secret string used to protect your Vercel Cron routes from unauthorized access
CRON_SECRET="your_secure_cron_secret"

# Rate Limiting (Upstash Redis) - OPTIONAL
# If you want to enable rate limiting on your API routes for high-demand ticket drops:
# 1. Create a free Redis database at Upstash
# 2. Run: npm i @upstash/ratelimit @upstash/redis
# 3. Add these keys:
# UPSTASH_REDIS_REST_URL="your_upstash_url"
# UPSTASH_REDIS_REST_TOKEN="your_upstash_token"